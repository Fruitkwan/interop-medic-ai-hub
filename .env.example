# Copy to .env (git-ignored) and edit. Every value is optional.

# Password for _SYSTEM, SuperUser and Admin, applied at container start. Blank keeps the demo password SYS.
IRIS_PASSWORD=

# Host ports, if 52773 / 1972 are taken.
# MEDIC_WEB_PORT=52773
# MEDIC_SS_PORT=1972

# IRIS image: the AI Hub Early Access build once loaded and retagged (see README).
# IRIS_IMAGE=irishealth-community:2026.3.0AI.154.0

# Agent tier. Blank = offline mock. The real agent needs the AI Hub image (IRIS_IMAGE above) and an LLM key.
# MEDIC_AGENT_PROVIDER=Medic.Provider.AIHubAgent
# AIHUB_PROVIDER=openai
# AIHUB_MODEL=gpt-5-mini
# AIHUB_API_KEY=
# USD per million tokens, for cost tracking.
# AIHUB_PRICE_IN_PER_MTOK=
# AIHUB_PRICE_OUT_PER_MTOK=

# More agent models for the web page's model switch, as "Label=provider:model" (provider names as in
# AI Hub: gemini, openai, anthropic, xai, deepseek, ...). An entry is shown only when its key is set:
# <PROVIDER>_API_KEY here, or IRIS Interoperability credentials named Medic.<provider> (Password = key).
# Blank = one entry from AIHUB_PROVIDER / AIHUB_MODEL / AIHUB_API_KEY.
# OpenRouter is built in: Kimi=openrouter:moonshotai/kimi-k2 with OPENROUTER_API_KEY.
# Any other OpenAI-compatible API: pick a provider name, set <NAME>_BASE_URL and <NAME>_API_KEY,
# e.g. Mercury 2.5=inception:mercury-2.5 with INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1/
# Fast chat models for the fast tier (OpenAI-compatible APIs, keys as above). Same format.
# MEDIC_FAST_MODELS=Mercury 2.5=inception:mercury-2.5
# MEDIC_AGENT_MODELS=Gemini=gemini:gemini-3.5-flash,GPT=openai:gpt-5-mini,Claude=anthropic:claude-sonnet-5-5,Grok=xai:grok-4
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# Fast tier. Blank = offline mock. For Jev or Laya use Medic.Provider.SystemOne.
# MEDIC_FAST_PROVIDER=Medic.Provider.SystemOne
# Local Laya (laya-serve):  http://host.docker.internal:8000   ollaya: http://host.docker.internal:11435
# SYSTEMONE_BASE_URL=http://host.docker.internal:8000
# SYSTEMONE_API_KEY=
# Required by hosted Jev (https://api.typesafe.ai): jev-latest or jev-preview. Optional for Laya.
# SYSTEMONE_MODEL=jev-latest
# USD per million input tokens for cost tracking (self-hosted Laya: 0).
# SYSTEMONE_PRICE_PER_MTOK=0

# Laya for the web page's model switch (fast tier "Laya"; no model is sent). Blank hides the choice.
# LAYA_BASE_URL=http://host.docker.internal:8000

# Local Ollama for the web page's model switch: "Ollama" on the fast tier (a System One decision
# model, served at /v1/systemone) and on the agent (any tool-calling chat model, via /v1). Blank hides both.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_FAST_MODEL=nimble-v3
# Set to also offer an Ollama model on the agent (blank: fast tier only).
# OLLAMA_AGENT_MODEL=gemma4
# Seconds the fast tier waits for Ollama (CPU-only machines can take minutes).
# OLLAMA_TIMEOUT=600
