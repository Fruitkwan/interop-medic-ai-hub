# Copy to .env (git-ignored) and edit. Every value is optional.

# Password for _SYSTEM, SuperUser and Admin, applied at container start. Blank keeps the demo password SYS.
IRIS_PASSWORD=

# Host ports, if 52773 / 1972 are taken.
# MEDIC_WEB_PORT=52773
# MEDIC_SS_PORT=1972

# IRIS image: the AI Hub Early Access build once loaded and retagged (see README).
# IRIS_IMAGE=irishealth-community:2026.3.0AI.154.0

# Keys for the models on the page's menus. Every one is optional: a model with no key stays greyed
# out, and a visitor can also paste their own key into the page (API keys button).
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# INCEPTION_API_KEY=
# OPENROUTER_API_KEY=

# The menus, as "Label=provider:model". Blank uses the defaults in docker-compose.yml, which are:
# MEDIC_FAST_MODELS=Mercury Decide=inception:mercury-decide,Mercury 2.5=inception:mercury-2.5
# MEDIC_AGENT_MODELS=Gemini=gemini:gemini-3.5-flash,Claude=anthropic:claude-sonnet-5-5,ChatGPT=openai:gpt-5.4,Grok=xai:grok-4.5,Mercury 2.5=inception:mercury-2.5,Gemma=ollama:gemma4,Qwen=ollama:qwen3.8
# OpenRouter: add entries like Kimi=openrouter:moonshotai/kimi-k2
# Any other OpenAI-compatible API: pick a name, set <NAME>_BASE_URL and <NAME>_API_KEY.
# INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1/

# The production's default agent, for the demo feed and eval/run.py. Blank = offline mock.
# Needs the AI Hub image (IRIS_IMAGE above) and an LLM key.
# MEDIC_AGENT_PROVIDER=Medic.Provider.AIHubAgent
# AIHUB_PROVIDER=gemini
# AIHUB_MODEL=gemini-3.5-flash
# AIHUB_API_KEY=
# USD per million tokens, for cost tracking.
# AIHUB_PRICE_IN_PER_MTOK=
# AIHUB_PRICE_OUT_PER_MTOK=

# The production's default fast tier. Blank = offline mock. For Jev or Laya use Medic.Provider.SystemOne.
# The Jev menu entry needs SYSTEMONE_BASE_URL and SYSTEMONE_API_KEY.
# MEDIC_FAST_PROVIDER=Medic.Provider.SystemOne
# Local Laya (laya-serve):  http://host.docker.internal:8000   ollaya: http://host.docker.internal:11435
# SYSTEMONE_BASE_URL=http://host.docker.internal:8000
# SYSTEMONE_API_KEY=
# Required by hosted Jev (https://api.typesafe.ai): jev-latest or jev-preview. Optional for Laya.
# SYSTEMONE_MODEL=jev-latest
# USD per million input tokens for cost tracking (self-hosted Laya: 0).
# SYSTEMONE_PRICE_PER_MTOK=0

# Laya on the page's Fast menu (no model is sent). Blank hides the choice.
# LAYA_BASE_URL=http://host.docker.internal:8000

# Local Ollama: Nimble v3 on the fast tier (a System One decision model, served at /v1/systemone),
# Gemma and Qwen on the agent (tool-calling chat models, via /v1). Blank greys them out.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_FAST_MODEL=nimble-v3
# Seconds to wait for Ollama (CPU-only machines can take minutes).
# OLLAMA_TIMEOUT=600
